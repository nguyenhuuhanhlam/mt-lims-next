# --- Cấu hình Database (Kết nối tới MariaDB trên NAS) ---
DB_HOST=192.168.1.100
DB_PORT=3306
DB_NAME=mtlims
DB_USER=lims_user
DB_PASSWORD=your_secure_password

# --- Cấu hình Django ---
# Để False khi chạy thực tế (Production)
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production

# Danh sách IP hoặc tên miền được phép truy cập (cách nhau bởi dấu phẩy)
# Ví dụ: localhost,127.0.0.1,192.168.1.100,mtlims.synology.me
ALLOWED_HOSTS=localhost,127.0.0.1
